{
  "name": "vork-lite",
  "version": "0.1.0",
  "description": "vØrk Lite: an ESP32 as a Lite node of vØrk, the serverless identity-addressed network on WireGuard",
  "keywords": ["vork", "wireguard", "vpn", "mesh", "esp32", "esp-idf"],
  "repository": { "type": "git", "url": "https://github.com/vooteleaer/vork-lite.git" },
  "license": "MIT",
  "frameworks": ["espidf"],
  "platforms": ["espressif32"],
  "build": {
    "srcDir": "src",
    "includeDir": "include",
    "flags": ["-Isrc"]
  },
  "export": {
    "exclude": ["test", "examples/*/build", ".github"]
  }
}
